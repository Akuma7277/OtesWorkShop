# Telegram Bot Configuration
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Super Admin Telegram ID (can be comma-separated for multiple admins)
SUPER_ADMIN_IDS="YOUR_TELEGRAM_ID"

# Database Configuration (PostgreSQL)
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_strong_password"
POSTGRES_DB="shopim"

# Redis Configuration
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_DB="0"

# Application Settings
LOG_LEVEL="INFO" # DEBUG, INFO, WARNING, ERROR
CURRENCY_SYMBOL="so'm" # Or $, €, etc.

# Business Logic Configuration
MIN_USER_AGE=16
MAX_USER_AGE=100
MIN_TOPUP_AMOUNT=10000
DELIVERY_SLA_MINUTES=60
LOW_STOCK_NOTIFY_INTERVAL_HOURS=24
OPERATOR_CONTACT="@your_support_contact"

# Webhook settings (if you use webhooks instead of polling)
# BOT_WEBHOOK_HOST="https://your.domain.com"
# BOT_WEBHOOK_PATH="/path/to/webhook"
# WEB_SERVER_HOST="0.0.0.0"
# WEB_SERVER_PORT="8080"
